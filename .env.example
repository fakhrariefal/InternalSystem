# ==============================================================================
# Domestiq Hub System - Environment Variables Template
# Salin file ini menjadi .env lalu isi dengan kredensial project Anda.
# JANGAN PERNAH meng-commit file .env ke repository git.
# ==============================================================================

# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Web App Configuration (Vite client env)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
# Isi jika menggunakan named Firestore database (kosongkan untuk default)
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
